{
  "name": "libmarket-backend",
  "version": "1.0.0",
  "description": "Backend API for Community E-commerce SPA for Liberia",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:security": "cross-env NODE_ENV=test jest auth.security.test.js --detectOpenHandles --forceExit",
    "setup": "node scripts/setup-env.js",
    "create-admin": "node scripts/create-admin.js",
    "fix-roles": "node scripts/fix-roles.js",
    "audit:security": "npm audit && npm outdated",
    "migrate": "node scripts/migrate.js",
    "migrate:undo": "node scripts/migrate-undo.js",
    "db:sync": "node scripts/sync-db.js"
  },
  "keywords": [
    "ecommerce",
    "marketplace",
    "liberia",
    "community",
    "api",
    "nodejs",
    "express"
  ],
  "author": "LibMarket Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.2.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "node-cron": "^3.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "twilio": "^5.10.5",
    "uuid": "^9.0.0",
    "validator": "^13.15.23",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.46.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^25.0.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
