# ==============================================
# LibMarket Backend - Environment Variables
# ==============================================
# 
# ⚠️ SECURITY WARNING:
# - NEVER commit the actual .env file to Git
# - Generate strong random values for all secrets
# - Change ALL default values before deploying
#
# To generate secure JWT_SECRET (minimum 64 characters):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Environment
NODE_ENV=development
# Options: development, test, production

# Server
PORT=5000

# Database (Development uses SQLite)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Production PostgreSQL (uncomment for production)
# DB_DIALECT=postgres
# DB_HOST=your-database-host
# DB_PORT=5432
# DB_NAME=libmarket_production
# DB_USER=your_db_user
# DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_20_CHARS_MIN

# JWT Authentication
# ⚠️ CRITICAL: Must be 64+ random characters
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IMMEDIATELY_GENERATE_SECURE_64_CHAR_STRING
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Security - Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=http://localhost:5173
# Production: https://libmarket.com

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ============================================
# Email Configuration (Future Feature)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# FROM_EMAIL=noreply@libmarket.com
# FROM_NAME=LibMarket Team

# ============================================
# SMS Configuration (Liberia Mobile Money)
# ============================================
# SMS_API_KEY=your-sms-api-key
# SMS_API_URL=https://api.africas-talking.com
# SMS_SENDER_ID=LibMarket

# ============================================
# Payment Gateway (Future Feature)
# ============================================
# MOBILE_MONEY_API_KEY=your-payment-gateway-key
# MOBILE_MONEY_MERCHANT_ID=your-merchant-id

# ============================================
# Logging & Monitoring
# ============================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# Production Security Checklist
# ============================================
# Before deploying to production:
# ✅ Change JWT_SECRET to 64+ character random string
# ✅ Use strong database password (20+ characters)
# ✅ Enable HTTPS (set NODE_ENV=production)
# ✅ Configure production CORS_ORIGIN (no wildcards)
# ✅ Set up database backups
# ✅ Configure error monitoring (Sentry)
# ✅ Enable audit logging
# ✅ Use managed secrets (AWS Secrets Manager, etc.)
# ✅ Review all rate limits for production traffic
# ✅ Set up SSL/TLS certificates
# ✅ Configure firewall rules
# ✅ Enable database encryption at rest
# ✅ Set up automated security scanning

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890