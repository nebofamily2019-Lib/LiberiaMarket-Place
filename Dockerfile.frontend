# Frontend Dockerfile - Multi-stage production build
ARG NODE_VERSION=22-alpine
ARG CADDY_VERSION=2-alpine

FROM node:${NODE_VERSION} AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --silent
COPY frontend/ ./
RUN npm run build

# Production stage
FROM caddy:${CADDY_VERSION}

# NOTE: the official Caddy image runs as root (unlike the nginx image it
# replaces) — it needs that to bind ports 80/443 and manage its own
# certificate storage under /data and /config. See ARCHITECTURE-DECISION-RECORD.md
# for the tradeoff (automated TLS vs. a non-root proxy container).

# Copy built files from builder stage
COPY --from=builder /app/dist /srv

# Copy Caddy configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

# Expose ports (80 for HTTP + ACME challenge, 443 for HTTPS once DOMAIN is a real domain, 8080 internal-only healthcheck)
EXPOSE 80 443

# Caddy's default CMD already runs "caddy run --config /etc/caddy/Caddyfile" — no override needed
